PORT=4000

# Optional - if unset, the router falls back to the mock provider and the
# system still runs end-to-end.
OPENAI_API_KEY=
AI_API_KEY=

# Optional - if unset, memory uses the in-memory MemoryStore instead of Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional - if unset, the Research Agent falls back to LLM-only (no real
# search results). Get a key at tavily.com (free tier available).
TAVILY_API_KEY=

# Required for Gmail (and any other Composio-connected tool). Get your API
# key at app.composio.dev/developers.
COMPOSIO_API_KEY=

# Fallback user ID for tools without a pinned connected account below.
# Only matters if you don't set COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID.
COMPOSIO_USER_ID=default

# Recommended: pin the exact Gmail connection instead of guessing a user ID.
# Find this in the Composio dashboard under Connected Accounts (starts with "ca_").
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=

# Same idea, for posting Reddit replies via the Sales Agent's lead-gen mode.
COMPOSIO_REDDIT_CONNECTED_ACCOUNT_ID=

# Same idea, for creating GitHub repos/commits/PRs. Connect GitHub in the
# Composio dashboard, then find its Connected Account ID the same way.
COMPOSIO_GITHUB_CONNECTED_ACCOUNT_ID=

# RECOMMENDED: Twilio WhatsApp Sandbox - works in minutes, no business
# verification needed. Sign up at twilio.com, grab your Account SID and
# Auth Token from the console dashboard. Then, from your phone, WhatsApp
# "join <your sandbox keyword>" to the shown Twilio number to opt in before
# testing (Twilio can only message numbers that joined your sandbox).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional - defaults to Twilio's shared sandbox number. Override once you
# have your own approved Twilio WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional - Content Studio's cover-image generation. Uses OpenAI's Images
# API (gpt-image-1 - DALL-E 3 was retired March 2026). Skipped gracefully
# if not set, same as Tavily for search. May require completing OpenAI's
# "API Organization Verification" in your developer console before image
# models work, even with a valid key.
OPENAI_API_KEY=
# Optional - override the image model (e.g. if a newer gpt-image-N ships).
OPENAI_IMAGE_MODEL=gpt-image-1

# Speech-to-text (plugins/speech) reuses the same OPENAI_API_KEY above - no
# separate key needed. Uses whisper-1 specifically (not the newer
# gpt-4o-transcribe models), since only whisper-1 supports timestamped/SRT
# output, which caption-burning needs. ~$0.006/minute of audio.

# Optional - Content Studio's YouTube trend research step, and available as
# a standalone tool for workflow graphs. Get a key from Google Cloud Console
# (enable "YouTube Data API v3" for your project, then create an API key -
# no OAuth needed, this only reads public search data). Note: search.list
# costs 100 of your 10,000 daily quota units, so this is good for roughly
# ~100 searches/day on the free tier.
YOUTUBE_API_KEY=

# Separately, posting comments (youtube.postComment) and uploading videos
# (youtube.upload) both need a Composio "youtube" OAuth connection - set
# that up in the Composio dashboard, same as gmail/reddit/github. Uses the
# same COMPOSIO_API_KEY already configured above. Note: the exact Composio
# tool slugs these actions call were not verified against a live account
# (no credentials were available to confirm them directly) - see the
# comments at the top of backend/plugins/youtube/actions/postComment.js and
# upload.js if either ever errors with an "unknown tool" style message.
# For incoming messages: in the Twilio Console under WhatsApp Sandbox
# Settings, set "WHEN A MESSAGE COMES IN" to your public URL (e.g. via
# ngrok) + /webhooks/whatsapp/twilio. No verify-token handshake needed,
# unlike Meta - just paste the URL.

# FALLBACK: Direct Meta WhatsApp Cloud API (bypasses Composio) - only
# needed if you've completed Meta's business verification. Get these from
# developers.facebook.com: create an app with the WhatsApp product, use the
# free test phone number for development. WHATSAPP_ACCESS_TOKEN is the
# temporary 24h token to start; generate a permanent one via a System User
# for production. Note: free-form messages only deliver within 24h of the
# recipient texting first - otherwise you need an approved template.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Required for incoming message webhooks. Make this any random string
# yourself, then enter the SAME string as "Verify Token" when you configure
# the webhook in Meta's WhatsApp API Setup > Configuration page. Local dev
# needs a public URL (e.g. via ngrok) pointed at /webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional - if set to a number > 0, automatically checks your inbox and
# drafts replies on this schedule (in minutes) instead of only when you
# manually ask in Chat. Drafted replies still land as pending_approval tasks -
# nothing sends without your explicit approval. Unset/0 = disabled (default).
GMAIL_TRIAGE_INTERVAL_MINUTES=

# Shared secret for the browser-extension/ companion extension. Make this any
# random string yourself, then paste the SAME string into the extension's
# popup. Without this set, /api/browser/* rejects every request (fails
# closed, not open) - the extension will show a paired-but-rejected state
# until this is set and the backend restarted.
BROWSER_EXTENSION_TOKEN=

# Optional - configures the "Generic API Connector" sample skill
# (backend/core/installer/registry/samples/api-connector). Connects to ONE
# external REST API at a time; install via `registry:api-connector`.
API_CONNECTOR_BASE_URL=
API_CONNECTOR_AUTH_TOKEN=


