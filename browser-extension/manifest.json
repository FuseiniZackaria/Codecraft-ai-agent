{
  "manifest_version": 3,
  "name": "CodeCraft AI - Browser Reporter",
  "version": "1.0.0",
  "description": "Reports the site you're currently viewing to your local CodeCraft AI instance.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeCraft AI Reporter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
