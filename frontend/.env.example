# Optional - defaults to http://localhost:4000/api if unset.
VITE_API_URL=

# Same value as BROWSER_EXTENSION_TOKEN in backend/.env. Lets the app poll
# /api/browser/prompt to show the "this site has an MCP server" banner.
# If left unset, that feature just stays quiet - no error, nothing shown.
VITE_BROWSER_EXTENSION_TOKEN=
