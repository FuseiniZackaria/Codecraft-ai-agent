# CodeCraft video worker settings. Copy to .env (npm run setup does it) and fill in.
# The worker never needs your database, storage or AI keys - only these two.

# Your backend's public address (Render), no slash at the end.
BACKEND_URL=https://your-backend.onrender.com
# The same long random value you set as VIDEO_WORKER_TOKEN on Render.
VIDEO_WORKER_TOKEN=

# Optional
# WORKER_ID=laptop
# WORK_DIR=            # where temporary files go (default: your temp folder)
# KEEP_TEMP=false      # true keeps the temporary files (for checking a result)
# WHISPER_MODEL=small.en   # medium.en = more accurate, about 3x slower
# VIDEO_CRF=16         # quality: lower = better (16 is visually lossless)
# VIDEO_PRESET=slow    # slower = smaller file at the same quality
